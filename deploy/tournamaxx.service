[Unit]
Description=TournaMAXX-Revival server
After=network-online.target
Wants=network-online.target

[Service]
User=tournamaxx
Group=tournamaxx
WorkingDirectory=/var/lib/tournamaxx
# The ports: written by the control panel (Settings).
EnvironmentFile=/var/lib/tournamaxx/server.env
ExecStart=/usr/bin/python3 /opt/tournamaxx/modem-server.py --log /var/lib/tournamaxx/modem-server.log --state /var/lib/tournamaxx/state.json $TMX_ARGS
# The log file has everything; the same lines on stdout would fill the journal.
StandardOutput=null
Restart=on-failure
RestartSec=3

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/tournamaxx

[Install]
WantedBy=multi-user.target
